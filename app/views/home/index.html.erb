<% content_for(:title, "Pont Chaban-Delmas — horaires des levées") %>

<div class="page">
  <header class="page-header">
    <h1>🌉 Pont Jacques-Chaban-Delmas</h1>
    <p class="subtitle">
      Horaires des prochaines levées du pont, pendant lesquelles la route est
      coupée pour laisser passer les bateaux.
    </p>
  </header>

  <% if @feed_unavailable %>
    <div class="card card--warning">
      <p>
        Impossible de récupérer les horaires auprès de Bordeaux Métropole pour
        le moment. Réessayez dans quelques minutes.
      </p>
    </div>
  <% elsif @next_lift.nil? %>
    <div class="card">
      <p>Aucune levée n'est programmée pour le moment.</p>
    </div>
  <% else %>
    <section class="card card--next">
      <p class="card-label">Prochaine levée</p>
      <p class="next-day"><%= relative_day_label(@next_lift.date) %></p>
      <p class="next-time">
        <%= @next_lift.closes_at.strftime("%H:%M") %>
        &rarr;
        <%= @next_lift.reopens_at.strftime("%H:%M") %>
        <span class="duration">(<%= lift_duration_label(@next_lift) %>)</span>
      </p>
      <p class="next-vessel"><%= vessel_label(@next_lift) %></p>
    </section>

    <% if @later_lifts.any? %>
      <section>
        <h2>Levées suivantes</h2>
        <div class="schedule-wrap">
          <table class="schedule">
            <thead>
              <tr>
                <th>Date</th>
                <th>Fermeture</th>
                <th>Réouverture</th>
                <th>Navire</th>
              </tr>
            </thead>
            <tbody>
              <% @later_lifts.each do |lift| %>
                <tr>
                  <td><%= relative_day_label(lift.date) %></td>
                  <td><%= lift.closes_at.strftime("%H:%M") %></td>
                  <td><%= lift.reopens_at.strftime("%H:%M") %></td>
                  <td><%= vessel_label(lift) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  <% end %>

  <footer class="page-footer">
    Données mises à jour toutes les 15 minutes, source :
    <a href="https://opendata.bordeaux-metropole.fr/explore/dataset/previsions_pont_chaban/" target="_blank" rel="noopener">
      données ouvertes de Bordeaux Métropole
    </a>.
  </footer>
</div>
